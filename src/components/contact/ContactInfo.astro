---
interface Props {
  heading: string;
  addressHeading: string;
  address: string;
  addressUrl: string;
  phoneHeading: string;
  phone: string;
  phoneLink: string;
  email?: string;
  emailLink?: string;
}

const {
  heading,
  addressHeading,
  address,
  addressUrl,
  phoneHeading,
  phone,
  phoneLink,
  email,
  emailLink,
} = Astro.props;
---

<main class="mx-auto w-full max-w-site flex-1 px-4 py-[50px] sm:px-6">
  <section>
    <h1
      class="relative mb-7 pb-5 font-sans text-[35px] font-medium leading-none text-brand after:absolute after:bottom-0 after:left-0 after:h-px after:w-[50px] after:bg-brand"
      data-key-path="contact.heading"
    >
      {heading}
    </h1>
  </section>

  <section class="grid gap-8 sm:grid-cols-2">
    <div class="space-y-3">
      <h2
        class="text-lg font-semibold text-text"
        data-reveal="up"
        data-key-path="contact.address_heading"
      >
        {addressHeading}
      </h2>

      <a
        href={addressUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start gap-2 text-base leading-[26px] text-[#404040] transition-colors hover:text-brand"
        data-reveal="up"
        data-key-path="contact.address"
      >
        <svg
          class="mt-1 size-4 shrink-0"
          viewBox="0 0 64 64"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M32,0C18.746,0,8,10.746,8,24c0,5.219,1.711,10.008,4.555,13.93c0.051,0.094,0.059,0.199,0.117,0.289l16,24C29.414,63.332,30.664,64,32,64s2.586-0.668,3.328-1.781l16-24c0.059-0.09,0.066-0.195,0.117-0.289C54.289,34.008,56,29.219,56,24C56,10.746,45.254,0,32,0z M32,32c-4.418,0-8-3.582-8-8s3.582-8,8-8s8,3.582,8,8S36.418,32,32,32z"
          />
        </svg>
        <span>{address}</span>
      </a>
    </div>

    <div class="space-y-3">
      <h2
        class="text-lg font-semibold text-text"
        data-reveal="up"
        data-key-path="contact.phone_heading"
      >
        {phoneHeading}
      </h2>

      <a
        href={`tel:${phone.replace(/[\s()-]/g, '')}`}
        class="flex items-start gap-2 text-base leading-[26px] text-[#404040] transition-colors hover:text-brand"
        data-reveal="up"
        data-key-path="contact.phone"
      >
        <svg
          class="mt-1 size-4 shrink-0"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.56 1 1 0 01-.25 1.01z"
          />
        </svg>
        <span>{phone}</span>
      </a>

      {email && (
        <a
          href={`mailto:${email}`}
          class="flex items-start gap-2 text-base leading-[26px] text-[#404040] transition-colors hover:text-brand"
          data-reveal="up"
          data-key-path="contact.email"
        >
          <svg
            class="mt-1 size-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span>{email}</span>
        </a>
      )}
    </div>
  </section>
</main>

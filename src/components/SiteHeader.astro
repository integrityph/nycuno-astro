---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/AboutUs' },
  { label: 'Contact Us', href: '/ContactUs' },
  { label: 'Downloads', href: '/DownloadApps' },
];

interface Props {
  currentPage?: string;
}

const { currentPage = 'Home' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-border bg-white shadow-sm">
  <nav
    class="mx-auto flex h-[76px] max-w-site items-center justify-between px-4 sm:px-6"
    aria-label="Main navigation"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="NYCUNO home">
      <img
        src="/images/nycuno-logo.png"
        alt="NYCUNO"
        class="h-[56px] w-auto object-contain"
      />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex size-11 flex-col items-center justify-center gap-1.5
            rounded-md border border-border min-[1199px]:hidden"
      aria-label="Open navigation menu"
      aria-controls="site-navigation"
      aria-expanded="false"
    >
      <span class="menu-line menu-line-top h-0.5 w-5 bg-brand"></span>
      <span class="menu-line menu-line-middle h-0.5 w-5 bg-brand"></span>
      <span class="menu-line menu-line-bottom h-0.5 w-5 bg-brand"></span>
    </button>

    <ul
      id="site-navigation"
      class="absolute left-1/2 top-full z-50 w-screen
            -translate-x-1/2 overflow-hidden
            max-h-0 opacity-0
            border-b border-border bg-white shadow-md
            transition-[max-height,opacity] duration-300 ease-in-out
            md:static md:flex md:w-auto md:translate-x-0
            md:max-h-none md:flex-row md:items-center
            md:overflow-visible md:opacity-100
            md:border-0 md:shadow-none"
    >
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPage === link.label ? 'page' : undefined}
            class:list={[
              'flex min-h-12 items-center px-5 text-sm font-medium transition-colors md:min-h-[76px]',
              currentPage === link.label
                ? 'bg-brand-nav text-white'
                : 'text-text hover:bg-brand-nav hover:text-white',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const navigation = document.querySelector<HTMLUListElement>('#site-navigation');

  function setMenuOpen(isOpen: boolean) {
    if (!toggle || !navigation) return;

    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? 'Close navigation menu' : 'Open navigation menu',
    );

    navigation.classList.toggle('max-h-0', !isOpen);
    navigation.classList.toggle('max-h-[320px]', isOpen);
    navigation.classList.toggle('opacity-0', !isOpen);
    navigation.classList.toggle('opacity-100', isOpen);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  const desktopMedia = window.matchMedia('(min-width: 1199px)');

  desktopMedia.addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });
</script>

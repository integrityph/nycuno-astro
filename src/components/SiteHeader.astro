---
const navLinks = [
  { label: 'Home', href: '/index.html' },
  { label: 'About Us', href: '/AboutUs.html' },
  { label: 'Contact Us', href: '/ContactUs.html' },
  { label: 'Downloads', href: '/DownloadApps.html' },
];

interface Props {
  currentPage?: string;
}

const { currentPage = 'Home' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-border bg-white shadow-sm">
  <nav
    class="mx-auto flex min-h-[76px] max-w-site items-center justify-between px-4 sm:px-6"
    aria-label="Main navigation"
  >
    <a href="/index.html" class="flex shrink-0 items-center" aria-label="NYCUNO home">
      <img
        src="/images/nycuno-logo.png"
        alt="NYCUNO"
        class="h-12 w-[150px] object-contain sm:w-[190px]"
      />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex size-11 flex-col items-center justify-center gap-1.5 rounded-md border border-border md:hidden"
      aria-label="Open navigation menu"
      aria-controls="site-navigation"
      aria-expanded="false"
    >
      <span class="h-0.5 w-5 bg-black"></span>
      <span class="h-0.5 w-5 bg-black"></span>
      <span class="h-0.5 w-5 bg-black"></span>
    </button>

    <ul
      id="site-navigation"
      class="absolute left-0 right-0 top-full hidden flex-col border-b border-border bg-white shadow-md md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:shadow-none"
    >
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={currentPage === link.label ? 'page' : undefined}
            class:list={[
              'flex min-h-12 items-center px-5 text-sm font-medium transition-colors md:min-h-[76px]',
              currentPage === link.label
                ? 'bg-brand-nav text-white'
                : 'text-text hover:bg-brand-nav hover:text-white',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const navigation = document.querySelector<HTMLUListElement>('#site-navigation');

  toggle?.addEventListener('click', () => {
    if (!navigation) return;

    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

    toggle.setAttribute('aria-expanded', String(!isExpanded));
    toggle.setAttribute(
      'aria-label',
      isExpanded ? 'Open navigation menu' : 'Close navigation menu',
    );
    navigation.classList.toggle('hidden', isExpanded);
  });
</script>

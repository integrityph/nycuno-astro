---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<article 
  class="flex h-full w-full flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg"
  data-reveal="up"
>
  <div class="mb-5 flex size-14 shrink-0 items-center justify-center rounded-full bg-[#ffd44a]">
    <img
      src={icon}
      alt=""
      aria-hidden="true"
      class="size-8 object-contain"
      loading="lazy"
    />
  </div>

  <h3 class="mb-3 text-lg font-semibold">{title}</h3>

  <p class="text-sm leading-7 text-text-muted">
    {description}
  </p>
</article>

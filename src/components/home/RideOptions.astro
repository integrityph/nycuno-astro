---
import RideOptionCard from '@/components/RideOptionCard.astro';

interface Props {
  rideOptions: {
    heading: string;
    items: {
      title: string;
      description: string;
      icon: string;
    }[];
  };
}

const { rideOptions } = Astro.props;
---

<section class="bg-surface px-6 py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-site">
    <div class="mb-10 text-center sm:mb-14" data-reveal="up">
      <h2
        data-key-path="ride_options.heading"
        class="font-heading text-3xl font-bold sm:text-4xl"
      >
        {rideOptions.heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 justify-items-center gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {rideOptions.items.map((option, index) => (
        <RideOptionCard
          {...option}
          previewPath={`ride_options.items.${index}`}
        />
      ))}
    </div>
  </div>
</section>

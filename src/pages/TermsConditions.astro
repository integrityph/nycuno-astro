---
import MainLayout from "@/layouts/MainLayout.astro";
import TermsConditionsContent from "@/components/terms-conditions/TermsConditionsContent.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const termsConditionsPage = await getEntry(
  "termsConditionsPages",
  "terms-conditions",
);

if (!termsConditionsPage) {
  throw new Error("Terms & Conditions content not found.");
}

const heading = termsConditionsPage.data.heading;
const body = await marked.parse(termsConditionsPage.body ?? "");
---

<MainLayout
  title="Terms & Conditions | NYCUNO"
  description="Read NYCUNO's Terms and Conditions."
  currentPage="Terms & Conditions"
>
  <main>
    <TermsConditionsContent heading={heading} body={body} />
  </main>
</MainLayout>
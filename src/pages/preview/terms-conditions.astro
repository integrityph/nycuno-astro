---
import "@/styles/global.css";
import TermsConditionsContent from "@/components/terms-conditions/TermsConditionsContent.astro";
import { getEntry } from "astro:content";

const termsConditionsPage = await getEntry(
  "termsConditionsPages",
  "terms-conditions",
);

if (!termsConditionsPage) {
  throw new Error("Terms & Conditions content not found.");
}

const { heading } = termsConditionsPage.data;
const body = termsConditionsPage.body ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms & Conditions Preview</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div id="nycuno-terms-conditions-preview-root">
      <TermsConditionsContent heading={heading} body={body} />
    </div>
  </body>
</html>
---
import "@/styles/global.css";
import HelpCenterContent from "@/components/help-center/HelpCenterContent.astro";
import { getEntry } from "astro:content";

const helpCenterPage = await getEntry(
  "helpCenterPages",
  "help-center",
);

if (!helpCenterPage) {
  throw new Error("Help Center content not found.");
}

const { heading } = helpCenterPage.data;
const body = helpCenterPage.body ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Help Center Preview</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div id="nycuno-help-center-preview-root">
      <HelpCenterContent heading={heading} body={body} />
    </div>
  </body>
</html>
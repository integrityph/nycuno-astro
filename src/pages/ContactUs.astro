---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactInfo from '@/components/contact/ContactInfo.astro';
import { getEntry } from 'astro:content';

const contactPage = await getEntry('contactPages', 'contact');

if (!contactPage) {
  throw new Error('Contact Us content not found.');
}

const {
  heading,
  address_heading,
  address,
  address_url,
  phone_heading,
  phone,
  email,
} = contactPage.data.contact;
---

<MainLayout
  title="Contact Us"
  description="Contact NYCUNO"
  currentPage="Contact Us"
>
  <ContactInfo
    heading={heading}
    addressHeading={address_heading}
    address={address}
    addressUrl={address_url}
    phoneHeading={phone_heading}
    phone={phone}
    email={email}
  />
</MainLayout>

---
import MainLayout from '@/layouts/MainLayout.astro';
import PrivacyPolicy from '@/components/privacy/PrivacyPolicy.astro';
import { getEntry } from 'astro:content';

const privacyPolicy = await getEntry('privacyPolicy', 'privacy-policy');

if (!privacyPolicy) {
  throw new Error('Privacy Policy content not found.');
}
---

<MainLayout
  title={`${privacyPolicy.data.title} | NYCUNO`}
  description={privacyPolicy.data.description}
  currentPage="Privacy Policy"
>
  <PrivacyPolicy
    title={privacyPolicy.data.title}
    content={privacyPolicy.body ?? ''}
  />
</MainLayout>

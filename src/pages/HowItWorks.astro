---
import MainLayout from "@/layouts/MainLayout.astro";
import HowItWorksContent from "@/components/how-it-works/HowItWorksContent.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const howItWorksPage = await getEntry(
  "howItWorksPages",
  "how-it-works",
);

if (!howItWorksPage) {
  throw new Error('How it works content not found.');
}

const heading = howItWorksPage.data.heading;
const body = await marked.parse(howItWorksPage.body ?? "");
---

<MainLayout
  title="How It Works | NYCUNO"
  description="Learn how NYCUNO connects users with essential services through one convenient application."
  currentPage="How It Works"
>
  <HowItWorksContent heading={heading} body={body} />
</MainLayout>
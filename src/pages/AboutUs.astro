---
import MainLayout from '@/layouts/MainLayout.astro';
import AboutIntro from '@/components/about/AboutIntro.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const aboutPage = await getEntry('aboutPages', 'about');

if (!aboutPage) {
  throw new Error('About Us content not found.');
}

const { heading, paragraphs } = aboutPage.data.about_intro;

const renderedParagraphs = await Promise.all(
  paragraphs.map((paragraph) => marked.parse(paragraph))
);
---

<MainLayout
  title="About Us"
  description="Learn about NYCUNO, an affordable ride-hailing service in New York City."
  currentPage="About Us"
>
  <main>
    <AboutIntro
      heading={heading}
      paragraphs={renderedParagraphs}
    />
  </main>
</MainLayout>
---
import { getEntry } from "astro:content";

import MainLayout from '@/layouts/MainLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Benefits from '@/components/home/Benefits.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import Services from '@/components/home/Services.astro';
import DriveWithUs from '@/components/home/DriveWithUs.astro';
import RideOptions from '@/components/home/RideOptions.astro';
import PromotionalBanners from '@/components/home/PromotionalBanners.astro';
import EasyRegistration from '@/components/home/EasyRegistration.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import SafetySupport from '@/components/home/SafetySupport.astro';

const homepage = await getEntry("pages", "homepage");

if (!homepage) {
  throw new Error("Homepage content entry not found. Check src/content/pages/homepage.md");
}

const hero = homepage.data.hero;
const benefits = homepage.data.benefits;
const howItWorks = homepage.data.how_it_works;
const services = homepage.data.services;
const driveWithUs = homepage.data.drive_with_us;
const rideOptions = homepage.data.ride_options;
const promotionalBanners = homepage.data.promotional_banners;
const easyRegistration = homepage.data.easy_registration;
const testimonials = homepage.data.testimonials;
const safetySupport = homepage.data.safety_support;
---

<MainLayout
  title="NYCUNO | Ride For Less"
  description="Fast, reliable, and affordable rides across New York City."
  currentPage="Home"
>
  <main>
    <!-- Hero -->
    <Hero hero={hero} />

    <!-- Why Choose NYCUNO -->
    <Benefits benefits={benefits} />

    <!-- How It Works -->
    <HowItWorks howItWorks={howItWorks} />

    <!-- Our Services -->
    <Services services={services} />

    <!-- Drive with Us -->
    <DriveWithUs driveWithUs={driveWithUs} />

    <!-- Ride Options -->
    <RideOptions rideOptions={rideOptions} />

    <!-- Promotional Banners -->
    <PromotionalBanners promotionalBanners={promotionalBanners} />

    <!-- Easy Registration -->
    <EasyRegistration registration={easyRegistration} />

    <!-- What Our Riders Say -->
    <Testimonials testimonials={testimonials} />

    <!-- Safety & Support -->
    <SafetySupport safetySupport={safetySupport} />
  </main>
</MainLayout>

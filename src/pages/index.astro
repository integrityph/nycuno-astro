---
import MainLayout from '../layouts/MainLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<MainLayout
  title="NYCUNO | Ride For Less"
  description="Fast, reliable, and affordable rides across New York City."
>
  <SiteHeader currentPage="Home" />

  <main>
    <section class="bg-brand-light px-6 py-24 text-center sm:py-32">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest">
        Welcome to NYCUNO
      </p>

      <h1 class="font-heading text-5xl font-bold sm:text-7xl">
        Ride For <span class="text-brand-hover">Less</span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-text-muted">
        Fast, reliable, and affordable rides across New York City.
      </p>
    </section>
  </main>
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<MainLayout
  title="NYCUNO | Ride For Less"
  description="Fast, reliable, and affordable rides across New York City."
>
  <SiteHeader currentPage="Home" />

  <main>
    <section class="relative isolate min-h-[540px] overflow-hidden bg-black text-white sm:min-h-[650px]">
      <img
        src="/assets/img/home/nycuno-landing-img1.jpg"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />

      <div class="absolute inset-0 -z-10 bg-black/45"></div>

      <div class="mx-auto flex min-h-[540px] max-w-site items-center px-6 py-16 sm:min-h-[650px] sm:px-10">
        <div class="max-w-2xl">
          <h1 class="font-heading text-5xl font-bold sm:text-7xl">
            <span class="text-brand">NYC</span>Uno
          </h1>

          <h2 class="mt-3 font-heading text-4xl font-bold sm:text-6xl">
            Ride For <span class="text-brand">Less</span>
          </h2>

          <p class="mt-5 max-w-xl text-base leading-7 text-white/90 sm:text-lg">
            Fast, reliable, and affordable rides across New York City.
          </p>
        </div>

        <img
          src="/assets/img/NYC_UNO-5_OFF_d1_v1.jpg"
          alt="NYCUNO promotional offer"
          class="ml-auto hidden w-64 shrink-0 object-contain lg:block xl:w-80"
        />
      </div>
    </section>

    <!-- Why Choose NYCUNO -->
    <section class="bg-white px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-site">
        <div class="mb-10 text-center sm:mb-14">
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">
            Why Choose NYC Uno?
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Affordable Rides -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/lucide-DollarSign-Outlined-Black.svg"
                alt=""
                aria-hidden="true"
                class="size-8"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Affordable Rides</h3>
            <p class="text-sm leading-7 text-text-muted">
              Get where you need to be without stretching your budget, while
              enjoying a service designed for convenience and value. Smart
              journeys don't have to cost more.
            </p>
          </article>

          <!-- Complete Transparency -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-8"
                aria-hidden="true"
              >
                <path d="m21 21-4.34-4.34" />
                <circle cx="11" cy="11" r="8" />
              </svg>
            </div>
            <h3 class="mb-3 text-lg font-semibold">Complete Transparency</h3>
            <p class="text-sm leading-7 text-text-muted">
              No hidden peaks. No secret cuts. Every dollar is accounted for,
              visible to both rider and driver, ensuring fairness and trust
              in every trip.
            </p>
          </article>

          <!-- Safe & Secure -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/guard-check.svg"
                alt=""
                aria-hidden="true"
                class="size-8"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Safe &amp; Secure</h3>
            <p class="text-sm leading-7 text-text-muted">
              Trips where your peace of mind comes first. With verified
              drivers and support, you can travel knowing every journey is
              protected and help is always within reach.
            </p>
          </article>

          <!-- Eco-Friendly Options -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/leaf.svg"
                alt=""
                aria-hidden="true"
                class="size-8"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Eco-Friendly Options</h3>
            <p class="text-sm leading-7 text-text-muted">
              With available green rides in our fleet, you'll reduce your
              carbon footprint while still enjoying convenient rides.
              Travel smarter and greener with us.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="bg-surface px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-site">
        <div class="mb-10 text-center sm:mb-14">
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">
            How It Works
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          <!-- Step 1 -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-6 flex h-64 w-full items-center justify-center sm:h-72">
              <img
                src="/assets/img/home/iMockup%20-%20Google%20Pixel%208%20Pro.png"
                alt="NYCUNO app on a Google Pixel phone"
                loading="lazy"
                class="h-full max-w-full object-contain"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">
              1. Download &amp; Sign Up
            </h3>

            <p class="max-w-sm text-sm leading-7 text-text-muted">
              Get the NYC Uno app on your phone and create your account in
              minutes.
            </p>
          </article>

          <!-- Step 2 -->
          <article class="flex flex-col items-center text-center">
            <div class="mb-6 flex h-64 w-full items-center justify-center sm:h-72">
              <img
                src="/assets/img/home/iMockup%20-%20Google%20Pixel%208%20Pro%20front.png"
                alt="NYCUNO ride booking screen displayed on a phone"
                loading="lazy"
                class="h-full max-w-full object-contain"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">
              2. Book Your Ride
            </h3>

            <p class="max-w-sm text-sm leading-7 text-text-muted">
              Enter your destination, choose your ride option, and confirm
              your pickup.
            </p>
          </article>

          <!-- Step 3 -->
          <article class="flex flex-col items-center text-center sm:col-span-2 lg:col-span-1">
            <div class="mb-6 flex h-64 w-full items-center justify-center sm:h-72">
              <img
                src="/assets/img/home/iMockup%20-%20Google%20Pixel%208%20Pro%20tilt.png"
                alt="NYCUNO app displayed on an angled phone mockup"
                loading="lazy"
                class="h-full max-w-full object-contain"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">
              3. Track &amp; Arrive
            </h3>

            <p class="max-w-sm text-sm leading-7 text-text-muted">
              Watch your driver approach on the map and enjoy a smooth
              journey.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Our Services -->
    <section class="bg-white px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-site">
        <div class="mb-10 text-center sm:mb-14">
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">
            Our Services
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Book a Ride -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-6 py-8 text-center transition-shadow duration-300 hover:shadow-lg sm:px-8">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/car2ddd.svg"
                alt=""
                aria-hidden="true"
                class="size-9"
                loading="lazy"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">Book a Ride</h3>

            <p class="text-sm leading-7 text-text-muted">
              Instantly find and book a ride to your destination with just a
              few taps. Fast, efficient, and always available.
            </p>
          </article>

          <!-- Book for Someone Else -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-6 py-8 text-center transition-shadow duration-300 hover:shadow-lg sm:px-8">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/lucide-Users-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="size-9"
                loading="lazy"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">Book for Someone Else</h3>

            <p class="text-sm leading-7 text-text-muted">
              Easily arrange transportation for friends, family, or clients
              from your account, even if they don't have the app.
            </p>
          </article>

          <!-- Schedule a Ride -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-6 py-8 text-center transition-shadow duration-300 hover:shadow-lg sm:col-span-2 lg:col-span-1 sm:px-8">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/lucide-CalendarDays-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="size-9"
                loading="lazy"
              />
            </div>

            <h3 class="mb-3 text-lg font-semibold">Schedule a Ride</h3>

            <p class="text-sm leading-7 text-text-muted">
              Plan ahead and schedule your rides for a specific date and time,
              ensuring you're never late for an important event.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Drive with Us -->
    <section class="bg-brand-light px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-site">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <!-- Introduction -->
          <div>
            <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-hover">
              For Drivers
            </p>

            <h2 class="font-heading text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
              Drive with Us. Earn More with NYC Uno.
            </h2>

            <p class="mt-5 max-w-xl text-base leading-8 text-text-muted">
              Join our growing network of drivers and take control of your
              earnings. Enjoy higher commissions and flexible hours with NYC Uno.
            </p>

            <a
              href="https://play.google.com/store/apps/details?id=com.nycuno.driver"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center justify-center rounded-md bg-brand px-7 py-3 font-semibold text-text transition-colors duration-200 hover:bg-brand-hover hover:text-white"
            >
              Apply to Drive
            </a>
          </div>

          <!-- Driver Benefits -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <!-- Higher Commissions -->
            <article class="rounded-xl border border-border bg-white p-6">
              <img
                src="/assets/img/icon/lucide-Gauge-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="mb-5 size-8"
                loading="lazy"
              />
              <h3 class="mb-2 text-lg font-semibold">Higher Commissions</h3>
              <p class="text-sm leading-7 text-text-muted">
                Keep more of what you earn with our driver-friendly commission
                structure.
              </p>
            </article>

            <!-- Flexible Hours -->
            <article class="rounded-xl border border-border bg-white p-6">
              <img
                src="/assets/img/icon/lucide-Clock-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="mb-5 size-8"
                loading="lazy"
              />
              <h3 class="mb-2 text-lg font-semibold">Flexible Hours</h3>
              <p class="text-sm leading-7 text-text-muted">
                Drive when you want, where you want. Fit driving into your
                schedule.
              </p>
            </article>

            <!-- Earnings Transparency -->
            <article class="rounded-xl border border-border bg-white p-6">
              <img
                src="/assets/img/icon/lucide-DollarSign-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="mb-5 size-8"
                loading="lazy"
              />
              <h3 class="mb-2 text-lg font-semibold">Earnings Transparency</h3>
              <p class="text-sm leading-7 text-text-muted">
                Track your trips and earnings in real time, right inside the app.
              </p>
            </article>

            <!-- Dedicated Support -->
            <article class="rounded-xl border border-border bg-white p-6">
              <img
                src="/assets/img/icon/lucide-ShieldCheck-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="mb-5 size-8"
                loading="lazy"
              />
              <h3 class="mb-2 text-lg font-semibold">Dedicated Support</h3>
              <p class="text-sm leading-7 text-text-muted">
                Enjoy peace of mind with Dedicated Support, giving you 24/7
                access to driver assistance whenever you need it.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Ride Options -->
    <section class="bg-surface px-6 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-site">
        <div class="mb-10 text-center sm:mb-14">
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">
            Ride Options
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          <!-- Standard -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/taxi.svg"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Standard</h3>
            <p class="text-sm leading-7 text-text-muted">
              Your everyday affordable ride for getting around town.
            </p>
          </article>

          <!-- XL -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/car2ddd.svg"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">XL</h3>
            <p class="text-sm leading-7 text-text-muted">
              Need more space? Perfect for groups or extra luggage.
            </p>
          </article>

          <!-- Green -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/leaf.svg"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Green</h3>
            <p class="text-sm leading-7 text-text-muted">
              Travel green with our selection of electric and hybrid vehicles.
            </p>
          </article>

          <!-- Comfort -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/car.svg"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Comfort</h3>
            <p class="text-sm leading-7 text-text-muted">
              Premium service for when you want to ride in style and comfort.
            </p>
          </article>

          <!-- Executive -->
          <article class="flex flex-col items-center rounded-xl border border-border bg-white px-5 py-7 text-center transition-shadow duration-300 hover:shadow-lg sm:col-span-2 lg:col-span-1 xl:col-span-1">
            <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-brand-light">
              <img
                src="/assets/img/icon/lucide-Gem-Outlined.svg"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="mb-3 text-lg font-semibold">Executive</h3>
            <p class="text-sm leading-7 text-text-muted">
              Experience top-class comfort with high-end vehicles and
              professional drivers for the ultimate ride.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Promotional Banners -->
    <section class="bg-white px-4 py-8 sm:px-6 sm:py-10">
      <div class="mx-auto max-w-site rounded-lg bg-[#fafafb] px-4 py-10 sm:px-8 sm:py-16 lg:px-24 lg:py-28">
        <div class="flex flex-col gap-6 sm:gap-8">
          <!-- Driver Promotion -->
          <div class="flex flex-col items-center justify-between gap-6 rounded-2xl bg-[#131313] px-6 py-8 text-center sm:flex-row sm:px-8 sm:text-left">
            <h2 class="font-sans text-2xl font-bold text-white">
              Drive &amp; Earn with NYC Uno
            </h2>

            <a
              href="https://play.google.com/store/apps/details?id=com.nycuno.driver"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center rounded-2xl bg-[#ffd44a] px-5 py-2.5 font-semibold text-black transition-colors hover:bg-brand hover:outline hover:outline-2 hover:outline-offset-2 hover:outline-[#646566] sm:w-[156px]"
            >
              Apply to Drive
            </a>
          </div>

          <!-- Rider Referral Promotion -->
          <div class="flex flex-col items-center justify-between gap-6 rounded-2xl bg-[#ffd44a] px-6 py-8 text-center sm:flex-row sm:px-8 sm:text-left">
            <h2 class="font-sans text-2xl font-bold text-black">
              Invite friends. Earn cash credits.
            </h2>

            <a
              href="https://play.google.com/store/apps/details?id=com.nycuno.user"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center rounded-2xl bg-black px-5 py-2.5 font-semibold text-white transition-colors hover:outline hover:outline-2 hover:outline-offset-2 hover:outline-[#646566] sm:w-[156px]"
            >
              Refer Now
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Easy Registration -->
    <section class="bg-white px-4 py-12 sm:px-6 sm:py-16">
      <div class="mx-auto my-4 max-w-site sm:my-8">
        <!-- Section Heading -->
        <div class="mb-8 text-center sm:mb-10">
          <h2 class="font-heading text-3xl font-semibold sm:text-4xl">
            Easy Registration
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-text-muted sm:text-base">
            Register yourself and take amazing benefits from NYC Uno.
            Drivers can register and earn for the Rides. Users can
            register and book their Rides.
          </p>
        </div>

        <!-- Registration Cards -->
        <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-5">
          <!-- Rider Registration -->
          <a
            href="https://play.google.com/store/apps/details?id=com.nycuno.user"
            target="_blank"
            rel="noopener noreferrer"
            class="group overflow-hidden rounded-xl bg-white shadow-[0_0_21px_rgba(0,0,0,0.21)] transition-shadow hover:shadow-xl"
          >
            <img
              src="/nyc_img/pexels-cottonbro-4606338.jpg"
              alt="Rider registering for NYC Uno"
              class="aspect-[0.92] w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02] sm:aspect-video"
              loading="lazy"
            />
            <div class="flex items-center justify-between gap-4 px-6 py-6 sm:px-7">
              <h3 class="text-xl font-bold text-black sm:text-2xl">
                Register as a Rider
              </h3>
              <span
                aria-hidden="true"
                class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand text-xl text-black transition-colors group-hover:bg-brand-hover group-hover:text-white"
              >
                →
              </span>
            </div>
          </a>

          <!-- Driver Registration -->
          <a
            href="https://play.google.com/store/apps/details?id=com.nycuno.driver"
            target="_blank"
            rel="noopener noreferrer"
            class="group overflow-hidden rounded-xl bg-white shadow-[0_0_21px_rgba(0,0,0,0.21)] transition-shadow hover:shadow-xl"
          >
            <img
              src="/nyc_img/pexels-jeshoots-com-147458-13861.jpg"
              alt="Driver registering to drive with NYC Uno"
              class="aspect-[0.92] w-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02] sm:aspect-video"
              loading="lazy"
            />
            <div class="flex items-center justify-between gap-4 px-6 py-6 sm:px-7">
              <h3 class="text-xl font-bold text-black sm:text-2xl">
                Register as a Driver
              </h3>
              <span
                aria-hidden="true"
                class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand text-xl text-black transition-colors group-hover:bg-brand-hover group-hover:text-white"
              >
                →
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- What Our Riders Say -->
    <section class="mb-12 bg-white px-4 py-8 sm:mb-16 sm:px-6 sm:py-10">
      <div class="mx-auto max-w-site px-0 sm:px-2">
        <!-- Section Heading -->
        <div class="mb-8 text-center sm:mb-10">
          <h2 class="font-heading text-3xl font-semibold sm:text-4xl">
            What Our Riders Say
          </h2>
        </div>

        <!-- Testimonials -->
        <div class="flex flex-wrap items-stretch justify-center gap-6">
          <!-- Testimonial 1 -->
          <article class="flex w-full max-w-sm flex-col items-start rounded-xl bg-white p-6 shadow-[0_0_4px_rgba(0,0,0,0.2)]">
            <div class="mb-4 flex gap-1" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }, (_, i) => (
                <img
                  src="/assets/img/icon/shaded-star.svg"
                  alt=""
                  aria-hidden="true"
                  class="size-5"
                />
              ))}
            </div>
            <blockquote class="mb-4 font-sans text-lg font-medium italic leading-8">
              "Way cheaper than my usual rides in Manhattan. Smooth app!"
            </blockquote>
            <p class="mt-auto text-base text-[#171a1f]">- Jenna, NYC</p>
          </article>

          <!-- Testimonial 2 -->
          <article class="flex w-full max-w-sm flex-col items-start rounded-xl bg-white p-6 shadow-[0_0_4px_rgba(0,0,0,0.2)]">
            <div class="mb-4 flex gap-1" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }, (_, i) => (
                <img
                  src="/assets/img/icon/shaded-star.svg"
                  alt=""
                  aria-hidden="true"

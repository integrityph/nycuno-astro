---
import MainLayout from "@/layouts/MainLayout.astro";
import HelpCenterContent from "@/components/help-center/HelpCenterContent.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const helpCenterPage = await getEntry(
  "helpCenterPages",
  "help-center",
);

if (!helpCenterPage) {
  throw new Error("Help Center content not found.");
}

const heading = helpCenterPage.data.heading;
const body = await marked.parse(helpCenterPage.body ?? "");
---

<MainLayout
  title="Help Center | NYCUNO"
  description="Find answers and assistance for using NYCUNO."
  currentPage="Help Center"
>
  <main>
    <HelpCenterContent heading={heading} body={body} />
  </main>
</MainLayout>
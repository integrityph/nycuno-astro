---
import MainLayout from '@/layouts/MainLayout.astro';
import DownloadApps from '@/components/downloads/DownloadApps.astro';
import { getEntry } from 'astro:content';

const downloadPage = await getEntry('downloadPages', 'downloads');

if (!downloadPage) {
  throw new Error('Download Apps content not found.');
}

const {
  heading,
  description,
  app_store_url,
  google_play_url,
  app_store_image,
  google_play_image,
  background_image,
  phone_image,
  phone_image_alt,
} = downloadPage.data.download;
---

<MainLayout
  title="Download NYCUNO App"
  description="Download the NYCUNO app for convenient and reliable transportation services."
  currentPage="Downloads"
>
  <DownloadApps
    heading={heading}
    description={description}
    appStoreUrl={app_store_url}
    googlePlayUrl={google_play_url}
    appStoreImage={app_store_image}
    googlePlayImage={google_play_image}
    backgroundImage={background_image}
    phoneImage={phone_image}
    phoneImageAlt={phone_image_alt}
  />
</MainLayout>

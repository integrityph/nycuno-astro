---
import MainLayout from "@/layouts/MainLayout.astro";
import TrustSafetyContent from "@/components/trust-safety/TrustSafetyContent.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const trustSafetyPage = await getEntry(
  "trustSafetyPages",
  "trust-safety",
);

if (!trustSafetyPage) {
  throw new Error("Trust Safety content not found.");
}

const heading = trustSafetyPage.data.heading;
const body = await marked.parse(trustSafetyPage.body ?? "");
---

<MainLayout
  title="Trust Safety & Insurance"
  description="Trust, Safety & Insurance at NYCUNO"
  currentPage="Trust, Safety & Insurance"
>
  <main>
    <TrustSafetyContent heading={heading} body={body} />
  </main>
</MainLayout>
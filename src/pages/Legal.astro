---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalContent from '@/components/legal/LegalContent.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const legalPage = await getEntry('legalPages', 'legal');

if (!legalPage) {
  throw new Error('Legal content not found.');
}

const { heading } = legalPage.data;
const body = await marked.parse(legalPage.body ?? '');
---

<MainLayout
  title="Legal | NYCUNO"
  description="Read the legal terms and information governing the use of NYCUNO."
  currentPage="Legal"
>
  <main>
    <LegalContent heading={heading} body={body} />
  </main>
</MainLayout>